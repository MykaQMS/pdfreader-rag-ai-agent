# Chave de API da OpenAI (necessária para embeddings e geração de respostas)
OPENAI_API_KEY=sk-proj-exemplo-de-sua-chave-aqui

# URL da instância do Qdrant Vector Database
# Padrão: http://localhost:6333 (Docker) ou ":memory:" para testes em memória
QDRANT_URL=http://localhost:6333

# URL base da API do Inngest Dev Server (para polling de status pelo Streamlit)
INNGEST_API_BASE=http://127.0.0.1:8288/v1
